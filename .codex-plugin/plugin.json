{
  "name": "codemagic",
  "version": "1.3.0",
  "description": "Unofficial Codemagic build operations and iOS/Android signing guidance for coding agents.",
  "author": {
    "name": "Helge Sverre",
    "url": "https://github.com/HelgeSverre"
  },
  "homepage": "https://github.com/HelgeSverre/codemagic-skill",
  "repository": "https://github.com/HelgeSverre/codemagic-skill",
  "license": "MIT",
  "keywords": [
    "codemagic",
    "ci-cd",
    "claude-code",
    "codex",
    "agent-skills"
  ],
  "mcpServers": {
    "codemagic": {
      "command": "uvx",
      "args": [
        "--isolated",
        "--python",
        ">=3.11",
        "--from",
        "codemagic-agent-tools[mcp]==1.3.0",
        "codemagic-mcp"
      ],
      "env_vars": [
        "CODEMAGIC_API_KEY",
        "CODEMAGIC_API_TOKEN",
        "CM_API_TOKEN",
        "XDG_CONFIG_HOME"
      ]
    }
  }
}
